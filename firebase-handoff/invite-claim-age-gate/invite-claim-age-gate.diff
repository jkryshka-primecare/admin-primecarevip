diff --git a/functions/core/services/patient/inviteAge.js b/functions/core/services/patient/inviteAge.js
new file mode 100644
index 0000000..236b57c
--- /dev/null
+++ b/functions/core/services/patient/inviteAge.js
@@ -0,0 +1,34 @@
+// Invite/claim eligibility only. #615 is the one calendar-age implementation.
+const { createHash } = require('node:crypto');
+const { evaluateDiscoveryAge } = require('./rosterDiscovery');
+const AGE_REFUSALS = new Set(['MINOR', 'DOB_UNKNOWN']);
+function evaluateInviteAge({ doc, nowMs = Date.now() } = {}) {
+  if (!doc) return { ok: false, reason: 'NO_ROSTER_DOC' };
+  if (doc.dependent?.isMinor === true) return { ok: false, reason: 'MINOR' };
+  const age = evaluateDiscoveryAge({ dob: doc.dob, nowMs });
+  return age;
+}
+function ageError(reason) {
+  return Object.assign(new Error(reason), { code: reason, inviteReason: reason });
+}
+function requireInviteAge(doc, nowMs = Date.now()) {
+  const result = evaluateInviteAge({ doc, nowMs });
+  if (!result.ok) throw ageError(result.reason);
+  return result;
+}
+async function assertInviteAge({ db, patientId }) {
+  let snap;
+  try { snap = await db.collection('patients').doc(String(patientId)).get(); }
+  catch (_) { throw ageError('ROSTER_READ_FAILED'); }
+  return requireInviteAge(snap.exists ? snap.data() : null);
+}
+async function assertInviteTokenAge({ db, token }) {
+  const id = createHash('sha256').update(String(token)).digest('hex');
+  let snap;
+  try { snap = await db.collection('claimTokens').doc(id).get(); }
+  catch (_) { throw ageError('INVITE_TOKEN_UNREADABLE'); }
+  const pid = snap.exists && snap.get('elationPatientId');
+  if (!pid) throw ageError('INVITE_TOKEN_UNREADABLE');
+  return assertInviteAge({ db, patientId: pid });
+}
+module.exports = { evaluateInviteAge, requireInviteAge, assertInviteAge, assertInviteTokenAge, AGE_REFUSALS };
