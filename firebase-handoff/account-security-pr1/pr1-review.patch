--- /dev/null
+++ b/functions/core/services/patient/accountLifecycle.js
@@ -0,0 +1,205 @@
+// #617/#618: patient-scoped identity operations, never an invitation reservation.
+const crypto = require('crypto');
+const key = () => crypto.randomBytes(32).toString('base64url'); // Firebase UID: 43 printable characters, <=128.
+const fail = reason => Object.assign(new Error(reason), { lifecycleReason: reason });
+const generation = d => Number.isInteger(d.identityGeneration) ? d.identityGeneration : 0;
+
+async function acquireWork(db, FieldValue, patientId, kind, rawUid) {
+  const owner = key();
+  const ref = db.collection('patients').doc(String(patientId));
+  return db.runTransaction(async tx => {
+    const [snap, social] = await Promise.all([tx.get(ref), tx.get(db.collection('socialClaimLocks').doc(String(patientId)))]); const p = snap.exists ? snap.data() : null;
+    if (!p) throw fail('NO_PATIENT_RECORD');
+    if (p.accountReset?.state === 'running') throw fail('RESET_BUSY');
+    // Unknown/crashed ownership is not quiescence. Never steal a clock-expired lease.
+    if (p.accountWork || ['pending','reconciliation'].includes(social.get('state'))) throw fail('RESET_BUSY');
+    if (rawUid && (p.authUid !== rawUid || p.firebaseUid !== rawUid.toLowerCase())) throw fail('BINDING_MISMATCH');
+    const work = { owner, kind, rawUid: rawUid || null, generation: generation(p), startedAtMs: Date.now() };
+    tx.update(ref, { accountWork: work });
+    return work;
+  });
+}
+async function releaseWork(db, FieldValue, patientId, work) {
+  if (work.authUncertain || work.uncertain || work.inFlight) throw fail('ACCOUNT_EXECUTION_UNCERTAIN');
+  const ref = db.collection('patients').doc(String(patientId));
+  await db.runTransaction(async tx => {
+    const s = await tx.get(ref); const p = s.data() || {};
+    if (p.accountWork?.owner === work.owner && generation(p) === work.generation) tx.update(ref, { accountWork: FieldValue.delete() });
+  });
+}
+function assertWork(p, work) {
+  if (!p || p.accountReset?.state === 'running' || p.accountWork?.owner !== work.owner || generation(p) !== work.generation) throw fail('RESET_BUSY');
+}
+async function reconciliation(db, FieldValue, patientId, reason) {
+  const ref = db.collection('portalAccountReconciliation').doc(String(patientId));
+  const audit = db.collection('portalAdminAudit').doc();
+  const batch = db.batch();
+  batch.set(ref, { patientId: String(patientId), state: 'needs_review', reason, updatedAt: FieldValue.serverTimestamp() }, { merge: true });
+  batch.set(audit, { elationPatientId: String(patientId), action: 'account_reconciliation_required', reason, ok: false, at: FieldValue.serverTimestamp() });
+  await batch.commit(); // No best-effort success; unreadable/unwritable signal still blocks account operations.
+}
+async function uniqueBinding(db, patientId, rawUid) {
+  const [lc, exact] = await Promise.all([
+    db.collection('patients').where('firebaseUid', '==', rawUid.toLowerCase()).get(),
+    db.collection('patients').where('authUid', '==', rawUid).get(),
+  ]);
+  if ([...lc.docs, ...exact.docs].some(d => d.id !== String(patientId))) throw fail('IDENTITY_CONFLICT');
+}
+function patientAccount(user) {
+  if (Object.keys(user.customClaims || {}).some(k => !['role'].includes(k)) ||
+      (user.customClaims?.role && user.customClaims.role !== 'patient') ||
+      user.providerData.some(p => p.providerId !== 'password')) throw fail('IDENTITY_CONFLICT');
+}
+
+async function prepareClaimAccount({ db, auth, FieldValue, patientId, email, password, work }) {
+  const ref = db.collection('patients').doc(String(patientId));
+  let p = (await ref.get()).data(); assertWork(p, work);
+  if (p.firebaseUid && !(p.claimAccountIntent?.state === 'credential_pending' && p.claimAccountIntent.rawUid === p.authUid && p.firebaseUid === p.authUid.toLowerCase())) throw fail('ALREADY_CLAIMED');
+  let intent = p.claimAccountIntent;
+  let rawUid = p.authUid || (intent?.generation === generation(p) && intent.rawUid);
+  let user, adopted = false;
+  if (rawUid) {
+    await uniqueBinding(db, patientId, rawUid);
+    try { user = await auth.getUser(rawUid); }
+    catch (e) { if (e.code !== 'auth/user-not-found') throw e; }
+    if (user) {
+      if (user.uid !== rawUid || String(user.email || '').toLowerCase() !== email.toLowerCase()) throw fail('IDENTITY_CONFLICT');
+      patientAccount(user);
+      if (user.disabled) throw fail('IDENTITY_CONFLICT');
+      // Only persisted patient.authUid or this patient's durable creation intent authorizes recovery.
+      adopted = true;
+    } else if (p.authUid) {
+      throw fail('IDENTITY_CONFLICT'); // Old exact identity missing: reset/reconcile, never guess another UID.
+    }
+  } else {
+    rawUid = key();
+    intent = { rawUid, generation: generation(p), operationId: work.owner, state: 'prepared' };
+    await db.runTransaction(async tx => {
+      const s = await tx.get(ref); assertWork(s.data(), work);
+      tx.update(ref, { claimAccountIntent: intent });
+    });
+  }
+  if (!user) {
+    work.authUncertain = true;
+    try { user = await auth.createUser({ uid: rawUid, email, password, emailVerified: false }); work.authUncertain = false; }
+    catch (e) {
+      // An explicit collision is never recovery evidence; no email ownership lookup.
+      if (['auth/email-already-exists', 'auth/uid-already-exists'].includes(e.code)) { work.authUncertain = false; throw fail('IDENTITY_CONFLICT'); }
+      // Persist uncertainty before returning; a duplicate cannot be mistaken for live benign work.
+      await markWorkUncertain(db, patientId, work);
+      throw e;
+    }
+  }
+  await db.runTransaction(async tx => {
+    const s = await tx.get(ref); assertWork(s.data(), work);
+    tx.update(ref, { claimAccountIntent: { rawUid, generation: work.generation, operationId: work.owner, state: p.claimAccountIntent?.state === 'credential_pending' ? 'credential_pending' : 'created' } });
+  });
+  return { user, adopted };
+}
+
+async function markWorkUncertain(db, patientId, work) {
+  const ref = db.collection('patients').doc(String(patientId));
+  await db.runTransaction(async tx => {
+    const s = await tx.get(ref); assertWork(s.data(), work);
+    tx.update(ref, { 'accountWork.uncertain': true });
+  });
+}
+
+// Resume only the existing patient-scoped reset; never remint or send an invitation.
+async function resumePatientReset(args) {
+  const p = (await args.db.collection('patients').doc(String(args.patientId)).get()).data();
+  if (!p || !p.accountReset?.owner) throw fail('NO_RESET_TO_RESUME');
+  if (p.accountReset.state === 'done') return { alreadyDone: true };
+  if (p.accountReset.state !== 'running') throw fail('IDENTITY_UNVERIFIED');
+  return resetPatientAccount(args);
+}
+
+async function resetPatientAccount({ db, auth, FieldValue, patientId, actor, reason }) {
+  const ref = db.collection('patients').doc(String(patientId));
+  let p = (await ref.get()).data(); if (!p) throw fail('NO_PATIENT_RECORD');
+  if (p.accountWork) throw fail('RESET_BUSY');
+  let rawUid = p.authUid;
+  if (!rawUid) {
+    // Legacy fallback only discovers a candidate; binding+server audit proves ownership.
+    if (!p.firebaseUid || !p.email) throw fail('IDENTITY_UNVERIFIED');
+    const roster = await db.collection('patients').select('email').get();
+    if (roster.docs.filter(d => String(d.get('email') || '').trim().toLowerCase() === p.email.trim().toLowerCase()).length !== 1) throw fail('IDENTITY_UNVERIFIED');
+    const user = await auth.getUserByEmail(p.email);
+    const evidence = await db.collection('phi_access_log').where('elationPatientId', '==', String(patientId)).get();
+    if (user.uid.toLowerCase() !== p.firebaseUid || !evidence.docs.some(d => {
+      const a = d.data(); return a.action === 'member_bound' && a.boundAuthUid === user.uid && a.boundUid === p.firebaseUid;
+    })) throw fail('IDENTITY_UNVERIFIED');
+    rawUid = user.uid;
+  }
+  if (p.firebaseUid && p.firebaseUid !== rawUid.toLowerCase()) throw fail('IDENTITY_CONFLICT');
+  await uniqueBinding(db, patientId, rawUid);
+  let user;
+  try { user = await auth.getUser(rawUid); } catch (e) { if (e.code !== 'auth/user-not-found') throw e; }
+  if (user) patientAccount(user);
+  const op = p.accountReset?.state === 'running' ? p.accountReset : { owner: key(), rawUid, generation: generation(p), state: 'running', startedAtMs: Date.now() };
+  if (op.rawUid !== rawUid) throw fail('IDENTITY_CONFLICT');
+  const jobRef = db.collection('claim_hydration_jobs').doc(String(patientId));
+  // R1: identity lock and queue/run reads share one transaction with worker acquisition.
+  await db.runTransaction(async tx => {
+    const [s, j, runs, lc, exact, social] = await Promise.all([
+      tx.get(ref), tx.get(jobRef), tx.get(db.collection('hydration_runs')),
+      tx.get(db.collection('patients').where('firebaseUid', '==', rawUid.toLowerCase())),
+      tx.get(db.collection('patients').where('authUid', '==', rawUid)),
+      tx.get(db.collection('socialClaimLocks').doc(String(patientId))),
+    ]);
+    const d = s.data() || {};
+    if (['pending','reconciliation'].includes(social.get('state')) || social.get('pendingUid') || d.accountWork || j.get('state') === 'running') throw fail('RESET_BUSY');
+    if (d.authUid !== p.authUid || d.firebaseUid !== p.firebaseUid || generation(d) !== op.generation ||
+        (d.accountReset?.state === 'running' && d.accountReset.owner !== op.owner) ||
+        [...lc.docs, ...exact.docs].some(x => x.id !== String(patientId))) throw fail('IDENTITY_CONFLICT');
+    // Legacy/other drivers have only run-level ownership. If THIS patient is in a live/unknown run, hold.
+    if (runs.docs.some(x => {
+      const r = x.data(); return (r.pending || []).includes(String(patientId)) && (r.leaseOwner || Number(r.leaseExpiresAt) > 0);
+    })) throw fail('RESET_BUSY');
+    tx.update(ref, { accountReset: op });
+    // Written at R1, not in a catch: a process crash still leaves an admin-visible signal.
+    tx.set(db.collection('portalAccountReconciliation').doc(String(patientId)), {
+      patientId: String(patientId), state: 'reset_in_progress', reason: 'RESET_IN_PROGRESS',
+      resumeAvailable: true, reviewAfterMs: (op.startedAtMs || Date.now()) + 60000,
+      updatedAt: FieldValue.serverTimestamp(),
+    }, { merge: true });
+  });
+  // Auth is outside Firestore: confirmation failure never clears binding.
+  if (user) {
+    await auth.updateUser(rawUid, { disabled: true });
+    await auth.revokeRefreshTokens(rawUid);
+    try { await auth.deleteUser(rawUid); } catch (e) { if (e.code !== 'auth/user-not-found') throw e; }
+  }
+  try { await auth.getUser(rawUid); throw fail('DELETE_UNCONFIRMED'); }
+  catch (e) { if (e.code !== 'auth/user-not-found') throw e; }
+  // R2: patient-only residue removal, after exact Auth absence and quiescence.
+  await db.runTransaction(async tx => {
+    const [s, j, runs, tokens] = await Promise.all([
+      tx.get(ref), tx.get(jobRef), tx.get(db.collection('hydration_runs')),
+      tx.get(db.collection('claimTokens').where('elationPatientId', '==', String(patientId))),
+    ]);
+    const d = s.data() || {};
+    if (d.accountReset?.owner !== op.owner || generation(d) !== op.generation || d.accountWork ||
+        d.authUid !== p.authUid || d.firebaseUid !== p.firebaseUid || j.get('state') === 'running') throw fail('RESET_BUSY');
+    for (const run of runs.docs) {
+      const r = run.data();
+      const touched = ['queued', 'pending'].some(k => Array.isArray(r[k]) && r[k].includes(String(patientId)));
+      if (!touched) continue;
+      if ((r.pending || []).includes(String(patientId)) && (r.leaseOwner || Number(r.leaseExpiresAt) > 0)) throw fail('RESET_BUSY');
+      tx.update(run.ref, { queued: FieldValue.arrayRemove(String(patientId)), pending: FieldValue.arrayRemove(String(patientId)) });
+    }
+    if (j.exists) { if (j.get('rawUid') !== rawUid) throw fail('IDENTITY_CONFLICT'); tx.delete(jobRef); }
+    for (const t of tokens.docs) if (!t.get('usedAt')) tx.update(t.ref, { usedAt: FieldValue.serverTimestamp(), revokedAt: FieldValue.serverTimestamp(), revokedBy: actor, revokeReason: 'verified claim reset' });
+    const cleared = {};
+    for (const k of ['firebaseUid','authUid','boundAt','claimedAt','webAccessVerifiedAt','claimAccountIntent','hydrationPendingAt','hydrationDeferredAt','hydrationDeferReason','hydrationRunId','hydrationLastRunId']) cleared[k] = FieldValue.delete();
+    if (d.hydrationStatus !== 'complete') { cleared.hydrationStatus = FieldValue.delete(); cleared.hydrationCompletedAt = FieldValue.delete(); cleared.hydrationLastSource = FieldValue.delete(); }
+    tx.update(ref, { ...cleared, identityGeneration: op.generation + 1, status: 'not_invited', accountReset: { ...op, state: 'done' }, claimReset: { at: FieldValue.serverTimestamp(), by: actor, reason, previousUid: rawUid } });
+    tx.set(db.collection('portalAccountReconciliation').doc(String(patientId)), {
+      patientId: String(patientId), state: 'resolved', reason: 'RESET_COMPLETED',
+      resumeAvailable: false, updatedAt: FieldValue.serverTimestamp(),
+    }, { merge: true });
+    tx.set(db.collection('portalAdminAudit').doc(), { action: 'claim_reset', elationPatientId: String(patientId), actor, reason, ok: true, at: FieldValue.serverTimestamp() });
+  });
+  return { rawUid };
+}
+module.exports = { key, generation, fail, acquireWork, releaseWork, assertWork, reconciliation, uniqueBinding, prepareClaimAccount, resetPatientAccount, resumePatientReset, markWorkUncertain };
