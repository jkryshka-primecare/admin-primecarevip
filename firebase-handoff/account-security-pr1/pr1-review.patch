@@ -0,0 +1,9 @@
+// #617: deadline wrappers are not proof that underlying mutating work stopped.
+const { AsyncLocalStorage } = require('node:async_hooks');
+const executions = new AsyncLocalStorage();
+const withIdentityExecution = (work, fn) => executions.run(work, fn);
+function noteUncertainExecution() {
+  const work = executions.getStore();
+  if (work) work.uncertain = true;
+}
+module.exports = { withIdentityExecution, noteUncertainExecution };
