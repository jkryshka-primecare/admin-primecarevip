+// A normal soft budget defers records, not proof of an abandoned mutation.
+// Join the real work inside this invocation; never release from a detached callback.
+async function awaitHydrationDrain(hydrate, budgetMs = 30000) {
+  let timer;
+  try {
+    return await Promise.race([
+      hydrate.then(() => true, () => true),
+      new Promise(resolve => { timer = setTimeout(() => resolve(false), budgetMs); }),
+    ]);
+  } finally { clearTimeout(timer); }
+}
+module.exports = { awaitHydrationDrain };
