diff --git a/artifacts/web-member/src/hooks/useArtifact.js b/artifacts/web-member/src/hooks/useArtifact.js
new file mode 100644
--- /dev/null
+++ b/artifacts/web-member/src/hooks/useArtifact.js
@@ -0,0 +1,196 @@
+// useArtifact — owns the whole lifecycle of one stored PDF for the artifact-mode
+// read CFs (getLabs | getImaging | getMedicalRecords).
+//
+// Release 2a artifact read contract:
+//   1. The signed URL is short-lived — 300s, pinned server-side. Never cache the link:
+//      re-request through fetchArtifact before it expires, and again if a viewer load
+//      fails because it expired anyway (clock skew, backgrounded tab).
+//   2. 200 { state: 'preparing' } means the reference exists but the object is being
+//      restored server-side. Render a friendly preparing state, NOT an error, NOT a 404.
+//      The server has already queued the repair; we just poll a bounded number of times.
+//   3. Absence is never "forbidden": hidden item, module off, wrong module and
+//      not-yet-synced ALL answer 404 ARTIFACT_NOT_SYNCED. The UI must not distinguish
+//      them or imply something was withheld.
+//   4. 403 ACCESS_SUSPENDED -> "portal access paused, contact the office". 503 -> transient.
+//
+// State shape (one of):
+//   { kind: 'idle' }
+//   { kind: 'loading' }
+//   { kind: 'preparing' }
+//   { kind: 'ready', url, expiresAt }
+//   { kind: 'error', message, transient }
+
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { fetchArtifact } from '../services/api/clinicalApi.js';
+
+// Re-request this far ahead of the stated expiry, so a click on Print/Download can
+// never race the 300s window. Also covers modest client clock skew.
+const REFRESH_LEAD_MS = 45000;
+// Floor, so a bad/short expiresAt can't turn into a refresh storm.
+const MIN_REFRESH_MS = 15000;
+
+const PREPARING_POLL_MS = 8000;
+const PREPARING_MAX_POLLS = 5; // ~40s, then we stop and leave the calm copy on screen
+
+export const ARTIFACT_COPY = {
+  // Deliberately identical for every flavour of absence — see contract rule 3.
+  notAvailable: 'This report is not available to view yet.',
+  preparing: 'We are preparing this document. It will be ready in a moment.',
+  preparingSlow:
+    'This document is still being prepared. Please check back shortly — no action is needed on your part.',
+  paused: 'Portal access is paused. Please contact the office and we will restore it.',
+  transient: 'We could not open this report just now. Please try again in a moment.',
+  signedOut: 'Your session expired. Please sign in again.',
+  offline: 'Connection problem. Please try again.',
+};
+
+/** Map a parseApiError shape to member-facing copy. Never leaks why something is absent. */
+export function friendlyArtifactError(error) {
+  const status = error?.httpStatus;
+  const reason = error?.reason;
+  if (reason === 'ARTIFACT_NOT_SYNCED' || status === 404) {
+    return { message: ARTIFACT_COPY.notAvailable, transient: false };
+  }
+  if (reason === 'ACCESS_SUSPENDED' || status === 403) {
+    return { message: ARTIFACT_COPY.paused, transient: false };
+  }
+  if (status === 401) return { message: ARTIFACT_COPY.signedOut, transient: false };
+  if (status === 0) return { message: ARTIFACT_COPY.offline, transient: true };
+  if (status === 503) return { message: ARTIFACT_COPY.transient, transient: true };
+  return { message: ARTIFACT_COPY.transient, transient: true };
+}
+
+function msUntilRefresh(expiresAt) {
+  if (!expiresAt) return null;
+  const at = Date.parse(expiresAt);
+  if (Number.isNaN(at)) return null;
+  return Math.max(MIN_REFRESH_MS, at - Date.now() - REFRESH_LEAD_MS);
+}
+
+/**
+ * @param {string} fnName  getLabs | getImaging | getMedicalRecords
+ * @param {() => Promise<string|null>} getIdToken from useAuth()
+ */
+export function useArtifact(fnName, getIdToken) {
+  const [state, setState] = useState({ kind: 'idle' });
+
+  // Generation counter: every open()/close() invalidates in-flight work, so a slow
+  // response for report A can never paint over report B.
+  const genRef = useRef(0);
+  const reportIdRef = useRef(null);
+  const timerRef = useRef(null);
+  const pollsRef = useRef(0);
+  const mountedRef = useRef(true);
+
+  const clearTimer = () => {
+    if (timerRef.current) {
+      clearTimeout(timerRef.current);
+      timerRef.current = null;
+    }
+  };
+
+  useEffect(() => () => {
+    mountedRef.current = false;
+    clearTimer();
+  }, []);
+
+  const load = useCallback(
+    async (reportId, gen, { polling } = {}) => {
+      if (!polling) {
+        pollsRef.current = 0;
+        setState({ kind: 'loading' });
+      }
+
+      const result = await fetchArtifact(fnName, reportId, getIdToken);
+      if (!mountedRef.current || gen !== genRef.current) return;
+
+      if (result.kind === 'artifact') {
+        pollsRef.current = 0;
+        const { signedUrl, expiresAt } = result.artifact;
+        setState({ kind: 'ready', url: signedUrl, expiresAt });
+
+        // Rule 1: re-request before the link dies rather than showing a broken PDF.
+        const wait = msUntilRefresh(expiresAt);
+        clearTimer();
+        if (wait != null) {
+          timerRef.current = setTimeout(() => {
+            if (gen === genRef.current) load(reportId, gen, { polling: true });
+          }, wait);
+        }
+        return;
+      }
+
+      // moduleOff comes back from the shared client when the care team turns a module
+      // off. Contract rule 3: the member sees plain absence, never "forbidden".
+      if (result.kind === 'moduleOff') {
+        clearTimer();
+        setState({ kind: 'error', message: ARTIFACT_COPY.notAvailable, transient: false });
+        return;
+      }
+
+      if (result.kind === 'suspended') {
+        clearTimer();
+        setState({ kind: 'error', message: ARTIFACT_COPY.paused, transient: false });
+        return;
+      }
+
+      if (result.kind === 'preparing') {
+        // Rule 2: a state, not an error. The repair is already queued server-side.
+        const attempt = pollsRef.current;
+        setState({
+          kind: 'preparing',
+          message: attempt >= 2 ? ARTIFACT_COPY.preparingSlow : ARTIFACT_COPY.preparing,
+        });
+        clearTimer();
+        if (attempt < PREPARING_MAX_POLLS) {
