+    limit: () => ({ get: async () => ({ empty: !rows.length, size: rows.length, docs: rows }) }),
+  }) }) };
+  return load.call(this, request, ...rest);
+};
+const { resolvePatientForCaller } = require('../../core/services/elation/resolvePatientForCaller');
