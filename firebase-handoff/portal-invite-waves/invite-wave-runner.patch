+// node functions/test/unit/invite-waves.test.cjs
+const assert = require('assert');
+const path = require('path');
+const W = require(path.join(__dirname, '..', '..', 'core', 'services', 'patient', 'inviteWaves.js'));
+const { pickCategory } = require(path.join(__dirname, '..', '..', 'core', 'services', 'email', 'sendgridEvents.js'));
+const t = (n, f) => { f(); console.log('ok', n); };
+
+t('ramp 20 -> 35 -> 50 -> 50 for 501 ids', () => {
+  const sizes = W.planWaves(Array.from({ length: 501 }, (_, i) => String(i))).map((w) => w.length);
+  assert.deepStrictEqual(sizes.slice(0, 4), [20, 35, 50, 50]);
+  assert.strictEqual(sizes.reduce((a, b) => a + b, 0), 501);
+  assert.strictEqual(sizes.length, 11);
+});
+t('order preserved', () => assert.deepStrictEqual(W.planWaves(['a', 'b', 'c'], [2], 1), [['a', 'b'], ['c']]));
+const base = { sent: 100, bouncedEmails: 0, spamEmails: 0, hoursSinceWaveEnd: 72, feedOk: true };
+t('bounce 1.99% passes, 2% stops', () => {
+  assert.strictEqual(W.evaluateGate({ ...base, sent: 1000, bouncedEmails: 19 }).pass, true);
+  assert.strictEqual(W.evaluateGate({ ...base, bouncedEmails: 2 }).reason, 'BOUNCE_RATE');
+});
+t('spam below 0.1% passes, 0.1% stops', () => {
+  assert.strictEqual(W.evaluateGate({ ...base, sent: 2000, spamEmails: 1 }).pass, true);
+  assert.strictEqual(W.evaluateGate({ ...base, sent: 1000, spamEmails: 1 }).reason, 'SPAM_RATE');
+});
+t('fails closed', () => {
+  assert.strictEqual(W.evaluateGate({ ...base, feedOk: false }).reason, 'EVENT_FEED_UNAVAILABLE');
+  assert.strictEqual(W.evaluateGate({ ...base, sent: 0 }).reason, 'NO_PRIOR_SENDS');
+  assert.strictEqual(W.evaluateGate({ ...base, hoursSinceWaveEnd: 10 }).reason, 'SETTLING');
+});
+const ok = { domainPrepComplete: true, approvedThroughWave: 1, enabled: true };
+t('live needs go + domain prep + wave approval + switch', () => {
+  assert.strictEqual(W.authorizeWave({ go: true, waveNumber: 1, config: ok }).live, true);
+  assert.strictEqual(W.authorizeWave({ go: false, waveNumber: 1, config: ok }).reason, 'DRY_RUN');
+  assert.strictEqual(W.authorizeWave({ go: true, waveNumber: 1, config: { ...ok, domainPrepComplete: false } }).reason, 'DOMAIN_PREP_PENDING');
+  assert.strictEqual(W.authorizeWave({ go: true, waveNumber: 2, config: ok }).reason, 'WAVE_NOT_APPROVED');
+  assert.strictEqual(W.authorizeWave({ go: true, waveNumber: 1, config: { ...ok, enabled: false } }).reason, 'KILL_SWITCH_OFF');
+  assert.strictEqual(W.authorizeWave({ go: true, waveNumber: 1, config: undefined }).live, false);
+});
+t('only portal_invite category stored', () => {
+  assert.strictEqual(pickCategory(['x', 'portal_invite']), 'portal_invite');
+  assert.strictEqual(pickCategory('newsletter'), null);
+  assert.strictEqual(pickCategory(undefined), null);
+});
