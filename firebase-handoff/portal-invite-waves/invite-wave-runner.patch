index 0000000..d854618
--- /dev/null
+++ b/functions/core/services/patient/inviteWaves.js
@@ -0,0 +1,53 @@
+// functions/core/services/patient/inviteWaves.js
+// PURE decision layer for the ramped portal-invite waves.
+// No I/O here: planning, the between-wave gate, and wave authorization.
+
+const RAMP = [20, 35, 50];
+const STEADY = 50;
+const MAX_BOUNCE_RATE = 0.02; // must be strictly below 2%
+const MAX_SPAM_RATE = 0.001; // must be strictly below 0.1%
+const DEFAULT_SETTLE_HOURS = 48;
+
+/** Split an ordered member-id list into waves: 20 -> 35 -> 50 -> 50 ... */
+function planWaves(ids, ramp = RAMP, steady = STEADY) {
+  const waves = [];
+  let i = 0;
+  while (i < ids.length) {
+    const size = waves.length < ramp.length ? ramp[waves.length] : steady;
+    waves.push(ids.slice(i, i + size));
+    i += size;
+  }
+  return waves;
+}
+
+/**
+ * Between-wave gate. Rates are over the prior wave's ACCEPTED sends.
+ * Fails closed on missing data, too-early checks, or zero sends.
+ */
+function evaluateGate({ sent, bouncedEmails, spamEmails, hoursSinceWaveEnd, settleHours = DEFAULT_SETTLE_HOURS, feedOk }) {
+  if (!feedOk) return { pass: false, reason: 'EVENT_FEED_UNAVAILABLE' };
+  if (!Number.isInteger(sent) || sent <= 0) return { pass: false, reason: 'NO_PRIOR_SENDS' };
+  if (!(hoursSinceWaveEnd >= settleHours)) return { pass: false, reason: 'SETTLING' };
+  const bounceRate = bouncedEmails / sent;
+  const spamRate = spamEmails / sent;
+  if (!(bounceRate < MAX_BOUNCE_RATE)) return { pass: false, reason: 'BOUNCE_RATE', bounceRate, spamRate };
+  if (!(spamRate < MAX_SPAM_RATE)) return { pass: false, reason: 'SPAM_RATE', bounceRate, spamRate };
+  return { pass: true, reason: 'CLEAR', bounceRate, spamRate };
+}
+
+/**
+ * Live sends need: explicit --go, a domain-prep sign-off, and an approval
+ * record that covers this wave number. Anything missing -> dry run only.
+ */
+function authorizeWave({ go, waveNumber, config }) {
+  const c = config || {};
+  if (go !== true) return { live: false, reason: 'DRY_RUN' };
+  if (c.domainPrepComplete !== true) return { live: false, reason: 'DOMAIN_PREP_PENDING' };
+  if (!Number.isInteger(c.approvedThroughWave) || c.approvedThroughWave < waveNumber) {
+    return { live: false, reason: 'WAVE_NOT_APPROVED' };
+  }
+  if (c.enabled !== true) return { live: false, reason: 'KILL_SWITCH_OFF' };
+  return { live: true, reason: 'APPROVED' };
+}
+
+module.exports = { RAMP, STEADY, MAX_BOUNCE_RATE, MAX_SPAM_RATE, DEFAULT_SETTLE_HOURS, planWaves, evaluateGate, authorizeWave };
diff --git a/functions/scripts/invite-wave-runner.js b/functions/scripts/invite-wave-runner.js
new file mode 100644
index 0000000..e84f24a
--- /dev/null
+++ b/functions/scripts/invite-wave-runner.js
@@ -0,0 +1,127 @@
+#!/usr/bin/env node
+// functions/scripts/invite-wave-runner.js
+// Ramped portal-invite waves for adult members who ALREADY have a portal record.
+//
+// DEFAULT IS REPORT-ONLY: plans waves, reads suppression + emailEvents, prints
+// per-wave COUNTS. It sends nothing and writes nothing.
+//
+// A live wave sends through the existing adminBatchReissue function (revoke the
+// stale/live link, mint a fresh 30-day link to the roster address, audited),
+// which re-checks eligibility and its own kill switch per member. inviteOne
+// then re-checks suppression immediately before each mint.
+// Live requires ALL of: --wave N --go, config/inviteWaves.domainPrepComplete,
+// config/inviteWaves.approvedThroughWave >= N, config/inviteWaves.enabled, and
+// for N>1 the prior wave's gate (bounce <2%, spam <0.1%, settled).
+//
+// Usage:
+//   node invite-wave-runner.js --list send_eligible_by_member_id.csv            # report only
+//   ADMIN_ID_TOKEN=... REISSUE_URL=... node invite-wave-runner.js --list ... --wave 1 --go
+// Only ids are printed; never emails or names.
+
+const fs = require('fs');
+const admin = require('firebase-admin');
+const { planWaves, evaluateGate, authorizeWave } = require('../core/services/patient/inviteWaves');
+const { loadSuppressedEmails, normalizeEmail } = require('../core/services/email/suppression');
+
+const arg = (k) => { const i = process.argv.indexOf(k); return i > -1 ? process.argv[i + 1] : undefined; };
+const INCLUDED_BUCKETS = new Set(['live_invite', 'expired_invite']); // claimed members are not reissued
+const CATEGORY = 'portal_invite';
+
+function readList(file) {
+  const [head, ...rows] = fs.readFileSync(file, 'utf8').trim().split('\n');
+  const cols = head.split(',');
+  return rows.map((r) => {
+    const v = r.split(',').map((x) => x.replace(/^"|"$/g, ''));
+    return Object.fromEntries(cols.map((c, i) => [c, v[i]]));
+  }).sort((a, b) => Number(a.sendOrder) - Number(b.sendOrder));
+}
+
+async function main() {
+  if (!admin.apps.length) {
+    admin.initializeApp(process.env.FIREBASE_SERVICE_ACCOUNT
+      ? { credential: admin.credential.cert(JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT)) } : {});
+  }
+  const db = admin.firestore();
+  const rows = readList(arg('--list'));
+  const excluded = {};
+  const ids = [];
+  for (const r of rows) {
+    if (r.outcome !== 'send' || !r.memberId) { excluded.NOT_SEND_OR_NO_RECORD = (excluded.NOT_SEND_OR_NO_RECORD || 0) + 1; continue; }
+    if (!INCLUDED_BUCKETS.has(r.bucket)) { excluded[`BUCKET_${r.bucket}`] = (excluded[`BUCKET_${r.bucket}`] || 0) + 1; continue; }
+    ids.push(r.memberId);
+  }
+  const waves = planWaves(ids);
+
+  // Live-data pre-check per wave (read-only): suppression + roster email.
+  const supp = await loadSuppressedEmails(db);
+  if (!supp.ok) throw new Error('SUPPRESSION_UNREADABLE');
+  const report = [];
+  for (let w = 0; w < waves.length; w++) {
+    const c = { wave: w + 1, planned: waves[w].length, suppressed: 0, claimedSince: 0, noRecordOrEmail: 0, ready: 0 };
+    for (const id of waves[w]) {
+      const s = await db.collection('patients').doc(id).get();
+      const d = s.exists ? s.data() : null;
+      const em = d && normalizeEmail(d.email);
+      if (!em) c.noRecordOrEmail++;
+      else if (d.authUid || d.firebaseUid) c.claimedSince++;
+      else if (supp.emails.has(em)) c.suppressed++;
+      else c.ready++;
+    }
+    report.push(c);
+  }
+  console.log(JSON.stringify({ mode: 'report', total: ids.length, excluded, waves: report }, null, 1));
+
+  const waveArg = arg('--wave');
+  if (!waveArg) return;
+  const n = Number(waveArg);
+  const cfg = (await db.collection('config').doc('inviteWaves').get()).data() || {};
+  const auth = authorizeWave({ go: process.argv.includes('--go'), waveNumber: n, config: cfg });
+
+  if (n > 1) {
+    const prior = (cfg.waves || {})[String(n - 1)];
+    let gate = { pass: false, reason: 'PRIOR_WAVE_NOT_RECORDED' };
+    if (prior && prior.endedAtMs) {
+      let feedOk = true; const bounced = new Set(); const spam = new Set();
+      try {
+        const ev = await db.collection('emailEvents').where('category', '==', CATEGORY).get(); // single-field filter: no composite index needed
+        const recips = new Set(prior.recipientHashes || []);
+        const crypto = require('crypto');
+        ev.forEach((doc) => {
+          const e = doc.data(); const h = crypto.createHash('sha256').update(normalizeEmail(e.email)).digest('hex');
+          if (!recips.has(h) || !(e.eventAtMs >= prior.startedAtMs)) return;
+          if (e.event === 'bounce' || e.event === 'dropped') bounced.add(h);
+          if (e.event === 'spamreport') spam.add(h);
+        });
+      } catch (e) { feedOk = false; }
+      gate = evaluateGate({ sent: prior.sent, bouncedEmails: bounced.size, spamEmails: spam.size,
+        hoursSinceWaveEnd: (Date.now() - prior.endedAtMs) / 36e5, settleHours: cfg.settleHours, feedOk });
+    }
+    console.log(JSON.stringify({ gateForWave: n, ...gate }));
+    if (!gate.pass) { console.log(JSON.stringify({ wave: n, sent: 0, stopped: gate.reason })); return; }
+  }
+  if (!auth.live) { console.log(JSON.stringify({ wave: n, sent: 0, stopped: auth.reason })); return; }
+
+  const batch = waves[n - 1] || [];
+  const startedAtMs = Date.now();
+  const r = await fetch(process.env.REISSUE_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${process.env.ADMIN_ID_TOKEN}` },
+    body: JSON.stringify({ patientIds: batch, cap: batch.length, dryRun: false, confirm: true, reason: `invite wave ${n}` }),
+  });
+  const out = await r.json();
+  // Record the wave for the next gate from the audit trail (the function's
+  // response samples only 25 ids). Counts + SHA-256 recipient hashes only.
+  const crypto = require('crypto');
+  const audit = await db.collection('portalAdminAudit').where('reason', '==', `invite wave ${n}`).get();
+  const hashes = new Set(); const sentIds = new Set();
+  audit.forEach((doc) => { const a = doc.data();
+    if (a.action !== 'batch_invite_reissued' || a.ok !== true || !batch.includes(a.elationPatientId)) return;
+    sentIds.add(a.elationPatientId); hashes.add(crypto.createHash('sha256').update(normalizeEmail(a.sentTo)).digest('hex')); });
+  out.reissuedIds = [...sentIds];
+  await db.collection('config').doc('inviteWaves').set({ waves: { [String(n)]: {
+    startedAtMs, endedAtMs: Date.now(), sent: (out.reissuedIds || []).length, recipientHashes: [...hashes],
+    skippedByReason: out.skippedByReason || {}, aborted: !!out.aborted } } }, { merge: true });
+  console.log(JSON.stringify({ wave: n, sent: (out.reissuedIds || []).length, skipped: out.skippedByReason || {}, aborted: !!out.aborted }));
+}
+
+main().catch((e) => { console.error('FAIL', e.message); process.exit(1); });
